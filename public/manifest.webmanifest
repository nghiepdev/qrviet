{
  "id": "./",
  "name": "QRViet — Tiện ích VietQR",
  "short_name": "QRViet",
  "description": "Tạo, quét, chia sẻ mã VietQR và mở app ngân hàng bằng Deeplink cho mọi ngân hàng Việt Nam. Miễn phí, riêng tư, chạy cả khi offline.",
  "lang": "vi",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fff8f4",
  "theme_color": "#d7263d",
  "categories": ["finance", "utilities", "productivity"],
  "icons": [
    { "src": "pwa-64x64.png", "sizes": "64x64", "type": "image/png" },
    { "src": "pwa-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "pwa-512x512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    {
      "name": "Tạo mã VietQR",
      "short_name": "Tạo QR",
      "url": "./?source=shortcut",
      "icons": [{ "src": "shortcuts/create.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Quét mã QR",
      "short_name": "Quét QR",
      "url": "./scan?source=shortcut",
      "icons": [{ "src": "shortcuts/scan.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Sổ tài khoản",
      "short_name": "Tài khoản",
      "url": "./accounts?source=shortcut",
      "icons": [{ "src": "shortcuts/accounts.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./scan",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "screenshots": [
    {
      "src": "screenshots/wide-create.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Tạo mã VietQR với mẫu ảnh đẹp"
    },
    {
      "src": "screenshots/wide-scan.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Quét và kiểm tra mã VietQR"
    },
    {
      "src": "screenshots/narrow-create.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Tạo mã ngay trên điện thoại"
    },
    {
      "src": "screenshots/narrow-themes.webp",
      "sizes": "780x1688",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Đa giao diện, chế độ tối"
    }
  ],
  "prefer_related_applications": false
